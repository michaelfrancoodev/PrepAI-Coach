# ============================================================
# CLIENT-SIDE (Vite) — copy this file to ".env" for local dev
# These are safe to expose in the browser bundle. They only allow
# access to Supabase's public/anon API, protected by Row Level
# Security policies on the database — never put secret keys here.
# ============================================================

# Your Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# ============================================================
# SERVER-SIDE (Supabase Edge Function secrets) — NOT read from
# this file. Set these with the Supabase CLI or Dashboard instead:
#
#   supabase secrets set GEMINI_API_KEY=your-real-key
#   supabase secrets set GEMINI_MODEL=gemini-2.5-flash
#   supabase secrets set GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
#
# They are listed here only so you know what to configure.
# NEVER put your real GEMINI_API_KEY in a VITE_ variable or in
# any file that ships to the browser — that would leak it to
# every visitor of your site.
# ============================================================

# Your Google AI Studio / Gemini API key. Get one free at
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OPTIONAL: multiple keys (comma-separated, no spaces) from different Google
# Cloud projects for automatic fallback when one project's free-tier quota
# runs out — e.g. "AIza...key1,AIza...key2". If set, this takes priority
# over GEMINI_API_KEY above.
# GEMINI_API_KEYS=

# Text/JSON model used for chat, feedback, roadmaps, etc.
# Default if unset: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Native speech-to-speech model used for Live Voice interviews.
# Default if unset: gemini-3.1-flash-live-preview
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# OPTIONAL: last-resort text fallback (Groq's free tier) used ONLY when
# every Gemini key above is exhausted, and only for text/JSON modes (not
# Live Voice — Groq has no equivalent free real-time speech-to-speech API).
# Get a free key with no credit card at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
